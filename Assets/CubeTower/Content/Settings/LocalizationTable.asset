--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: caf7ac734f0d3fa42b2e879f9b6dd236, type: 3}
  m_Name: LocalizationTable
  m_EditorClassIdentifier: 
  _fallbackLanguage: 10
  _entries:
  - _key: message.cube_placed
    _translations:
    - _language: 30
      _text: "\u041A\u0443\u0431\u0438\u043A \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D!"
    - _language: 10
      _text: Cube placed!
  - _key: message.cube_removed
    _translations:
    - _language: 30
      _text: "\u041A\u0443\u0431\u0438\u043A \u0432\u044B\u0431\u0440\u043E\u0448\u0435\u043D
        \u0432 \u0434\u044B\u0440\u0443"
    - _language: 10
      _text: The cube is thrown into the hole
  - _key: message.cube_missed
    _translations:
    - _language: 30
      _text: "\u041C\u0438\u043C\u043E! \u041A\u0443\u0431\u0438\u043A \u0438\u0441\u0447\u0435\u0437"
    - _language: 10
      _text: Missed! The cube is gone
  - _key: message.cube_returned
    _translations:
    - _language: 30
      _text: "\u041A\u0443\u0431\u0438\u043A \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
        \u043D\u0430 \u043C\u0435\u0441\u0442\u043E"
    - _language: 10
      _text: The cube went back to its place
  - _key: message.height_limit
    _translations:
    - _language: 30
      _text: "\u0411\u0430\u0448\u043D\u044F \u0434\u043E \u0441\u0430\u043C\u043E\u0433\u043E
        \u0432\u0435\u0440\u0445\u0430 - \u0432\u044B\u0448\u0435 \u0441\u0442\u0440\u043E\u0438\u0442\u044C
        \u043D\u0435\u043B\u044C\u0437\u044F"
    - _language: 10
      _text: The tower reached the top - no higher
  - _key: message.tower_full
    _translations:
    - _language: 30
      _text: "\u0411\u0430\u0448\u043D\u044F \u0434\u043E\u0441\u0442\u0430\u043B\u0430
        \u0434\u043E \u043A\u0440\u0430\u044F \u044D\u043A\u0440\u0430\u043D\u0430!"
    - _language: 10
      _text: The tower reached the top of the screen!
  - _key: message.color_mismatch
    _translations:
    - _language: 30
      _text: "\u0421\u0442\u0430\u0432\u044C \u043A\u0443\u0431\u0438\u043A \u043D\u0430
        \u043A\u0443\u0431\u0438\u043A \u0442\u043E\u0433\u043E \u0436\u0435 \u0446\u0432\u0435\u0442\u0430"
    - _language: 10
      _text: Put the cube on a cube of the same color
  - _key: message.placement_rejected
    _translations:
    - _language: 30
      _text: "\u0421\u044E\u0434\u0430 \u043A\u0443\u0431\u0438\u043A \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
        \u043D\u0435\u043B\u044C\u0437\u044F"
    - _language: 10
      _text: The cube cannot be placed here
  - _key: curtain.loading
    _translations:
    - _language: 30
      _text: "\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430..."
    - _language: 10
      _text: Loading...
  - _key: curtain.startup_error
    _translations:
    - _language: 30
      _text: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C
        \u0438\u0433\u0440\u0443. \u041F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0441\u0442\u0438
        \u0432 \u043B\u043E\u0433\u0435."
    - _language: 10
      _text: The game failed to start. See the log for details.
